# ─────────────────────────────────────────────────────────────────────────────
#  obs-lab · Environment Variables
#  cp .env.example .env  e preencha. O .env NAO vai pro git (.gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ===== Geral =====
ENVIRONMENT=lab
HOSTNAME_LAB=obs-lab-host
ERROR_RATE=0.08
LATENCY_JITTER_MS=150

# Falha ocasional nos /health de orders e payment. E o que os testes sinteticos
# do ThousandEyes enxergam: sem isso eles respondem 200 para sempre e nenhum
# alerta dispara na demo. Nao e janela fixa - e probabilidade por chamada.
HEALTH_ERROR_RATE=0.04
# Durante a janela de degradacao do payment (45s a cada 3min) a taxa sobe:
HEALTH_ERROR_RATE_DEGRADED=0.35
LOAD_VUS=8
THINK_TIME_MS=400
STATS_INTERVAL_S=30

# Rotina de fraude no load-gen (scraping, price tampering, card testing,
# velocity abuse, brute force, account takeover). false = so trafego legitimo.
FRAUD_ENABLED=true

# ===== Perfil do lab em Kubernetes (k8s-lab.sh) =====
# full  3 nos, AppD InfraViz e ThousandEyes ligados   ~10 GB RAM
# lite  2 nos, InfraViz e ThousandEyes desligados     ~5 GB RAM
LAB_PROFILE=full

# ===== Splunk Observability Cloud (metricas + APM + DBM) =====
SPLUNK_ACCESS_TOKEN=seu_token_aqui
SPLUNK_REALM=us0                 # us0 | us1 | eu0 | ap0 | jp0 | au0

# ===== Splunk Core / Enterprise (logs via HEC) =====
# Opcional. Sem isso, o lab roda normal - so nao manda logs de container.
# Formato: https://IP_OU_HOST:8088/services/collector  (8088 e a porta padrao do HEC)
#SPLUNK_HEC_URL=https://SEU_SPLUNK_CORE:8088/services/collector
#SPLUNK_HEC_TOKEN=seu_hec_token_aqui
SPLUNK_HEC_INDEX=main

# ===== Postgres (inventory-db) =====
DB_USER=obslab
DB_PASSWORD=troque_esta_senha
DB_NAME=inventory

# ===== AppDynamics (APM nos 3 tiers + Cluster Agent no K8s) =====
APPDYNAMICS_CONTROLLER_HOST_NAME=sua-conta.saas.appdynamics.com
APPDYNAMICS_CONTROLLER_PORT=443
APPDYNAMICS_CONTROLLER_SSL_ENABLED=true
APPDYNAMICS_AGENT_ACCOUNT_NAME=sua-conta
APPDYNAMICS_AGENT_ACCOUNT_ACCESS_KEY=sua_access_key_aqui
APPDYNAMICS_AGENT_APPLICATION_NAME=obs-lab

# ===== ThousandEyes Enterprise Agent =====
TE_ACCOUNT_TOKEN=seu_account_token_aqui

# ===== Cloudflare Tunnel (publica URLs pra internet) =====
# `make tunnel` usa o Quick Tunnel e NAO precisa de nada aqui - a URL efemera
# em *.trycloudflare.com sai no log (`make tunnel-url`).
# A variavel abaixo so e usada por `make tunnel-named` (hostname fixo), que
# exige um dominio usando a Cloudflare como DNS autoritativo.
# Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared
#CLOUDFLARE_TUNNEL_TOKEN=seu_tunnel_token_aqui
