# Stack OT gas. Copie para .env e preencha o HEC.
# O token HEC precisa: default = ot_metrics (datatype=metric, pra a telemetria)
# E permitir tambem o indice ot (eventos). Metrica vai por /services/collector;
# evento vai por /services/collector/raw?index=ot (o Telegraf monta a URL).

SPLUNK_HEC_URL=https://SEU_SPLUNK:8088/services/collector
SPLUNK_HEC_TOKEN=seu_token_ot_aqui

# Ritmo. Poll 5s = realista de SCADA. A curva de consumo de um "dia" roda em 20
# min pra a tela subir e descer visivelmente (realista no dado, vistoso na demo).
OT_POLL_INTERVAL=5s
SIM_UPDATE_S=5
SIM_DAY_MINUTES=20

# Medidores de gas (fase 2): com que frequencia o meter-sim le a vazao das zonas
# e publica consumo por MQTT. 5s acompanha o process-sim.
METER_POLL_S=5

# Falha automatica: o sim injeta falha sozinho, pra o painel ter evento sem
# ninguem mexer. 0.05 = ~5% dos ciclos. CYBER_FAULT_PROB = fracao dessas falhas
# que e ataque cyber (comando nao autorizado / spoof) em vez de operacao. Para
# disparar na mao, AUTO_FAULT=false e:
#   curl -X POST "http://localhost:8095/fault?zona=GS-02&tipo=vazamento&dur=30"
#   tipos: vazamento | sobrepressao | valvula_fechada | unauth_command | spoof
#   (odorizacao_off so no alvo zona=estacao)
AUTO_FAULT=true
AUTO_FAULT_PROB=0.05
CYBER_FAULT_PROB=0.25
