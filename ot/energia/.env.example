# Stack OT energia. Copie para .env e preencha o HEC.
# O token HEC deve ter o indice de METRICA ot_metrics como default (datatype=metric).

SPLUNK_HEC_URL=https://SEU_SPLUNK:8088/services/collector
SPLUNK_HEC_TOKEN=seu_token_ot_aqui

# Ritmo. Poll 5s = realista de SCADA. A curva de carga de um "dia" roda em 20
# min pra a tela subir e descer visivelmente (realista no dado, vistoso na demo).
OT_POLL_INTERVAL=5s
SIM_UPDATE_S=5
SIM_DAY_MINUTES=20

# Falha automatica: o sim injeta trip/sobrecarga/afundamento sozinho, pra o
# painel ter evento sem ninguem mexer. 0.05 = ~5% dos ciclos. Para desligar e
# so disparar na mao, use AUTO_FAULT=false e:
#   curl -X POST "http://localhost:8091/fault?feeder=AL-02&tipo=overload&dur=30"
#   tipos: overload | trip | sag   (sag so no alvo feeder=subestacao)
AUTO_FAULT=true
AUTO_FAULT_PROB=0.05
